<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.WatchPath" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Night mode: bright accent for buttons so they stand out on the dark surface -->
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
    </style>
</resources>