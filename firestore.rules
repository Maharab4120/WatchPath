rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Streaming links: readable by the app, writable only from the Firebase
    // Console (the console bypasses rules). The app can never change them.
    match /movie_links/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /tv_links/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Request counters
    match /requests/{requestId} {
      allow read: if request.auth != null;

      // First request for a title: the counter must start at 1, and the
      // user's marker doc must be created in the SAME transaction.
      allow create: if request.auth != null
          && request.resource.data.requestCount == 1
          && !exists(/databases/$(database)/documents/requests/$(requestId)/users/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/requests/$(requestId)/users/$(request.auth.uid));

      // Later requests: count can only go up by exactly 1, and only if this
      // user had NOT requested before and now does (marker doc is created).
      allow update: if request.auth != null
          && request.resource.data.requestCount == resource.data.requestCount + 1
          && !exists(/databases/$(database)/documents/requests/$(requestId)/users/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/requests/$(requestId)/users/$(request.auth.uid));

      allow delete: if false;

      // One marker doc per user per title: this is the dedup record.
      match /users/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Everything else is blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}