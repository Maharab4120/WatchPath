rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Streaming links: read-only for the app, edited via Firebase Console
    match /movie_links/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /tv_links/{id} {
      allow read: if true;
      allow write: if false;
    }

    // User-submitted reports (broken links etc.)
    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null; // Only logged-in users can report
      allow update, delete: if false; // Keep reports immutable
    }

    // Request counters
    match /requests/{requestId} {
      allow read: if true;

      // First request: counter starts at 1, and this user's marker doc
      // must be created in the same transaction.
      allow create: if request.auth != null
          && request.resource.data.requestCount == 1
          && !exists(/databases/$(database)/documents/requests/$(requestId)/users/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/requests/$(requestId)/users/$(request.auth.uid));

      // Later requests: count goes up by exactly 1, only for a user who
      // had not requested before.
      allow update: if request.auth != null
          && request.resource.data.requestCount == resource.data.requestCount + 1
          && !exists(/databases/$(database)/documents/requests/$(requestId)/users/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/requests/$(requestId)/users/$(request.auth.uid));

      allow delete: if false;

      // One marker doc per user per title (the dedup record)
      match /users/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Everything else is blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}